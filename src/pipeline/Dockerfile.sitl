# Full node image for Containernet's GCS/UAV/attacker nodes.
# Build this on Linux; PX4/Gazebo makes the resulting image large.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg lsb-release git build-essential cmake ninja-build \
    meson pkg-config libglib2.0-dev libsystemd-dev libxml2-dev \
    python3 python3-pip python3-venv python3-dev python3-setuptools \
    tcpdump hping3 iproute2 iputils-ping net-tools procps psmisc \
    && rm -rf /var/lib/apt/lists/*

# Gazebo Garden is the PX4-supported simulator generation for Ubuntu 22.04.
RUN curl -fsSL https://packages.osrfoundation.org/gazebo.gpg \
      -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable jammy main" \
      > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update && apt-get install -y --no-install-recommends gz-garden \
    && rm -rf /var/lib/apt/lists/*

# Install sudo and git buffer tweaks so PX4 setup scripts succeed
RUN apt-get update && apt-get install -y --no-install-recommends sudo \
    && rm -rf /var/lib/apt/lists/* \
    && echo '%sudo ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Pin PX4 to a known release. Clone in its own layer to guarantee caching.
ARG PX4_REF=v1.14.3
RUN git config --global http.postBuffer 524288000 \
    && git clone --recursive --branch ${PX4_REF} --depth 1 https://github.com/PX4/PX4-Autopilot.git /PX4-Autopilot

# Run official setup script
RUN cd /PX4-Autopilot && bash Tools/setup/ubuntu.sh --no-nuttx --no-sim-tools

# Install MAVLink Router from its upstream source and MAVSDK Python for the GCS node.
RUN git clone --depth 1 --recursive https://github.com/mavlink-router/mavlink-router.git /tmp/mavlink-router \
    && meson setup -Dsystemdsystemunitdir=/usr/lib/systemd/system /tmp/mavlink-router/build /tmp/mavlink-router \
    && ninja -C /tmp/mavlink-router/build && ninja -C /tmp/mavlink-router/build install \
    && ldconfig && rm -rf /tmp/mavlink-router
RUN python3 -m pip install --no-cache-dir "mavsdk>=2.0.0,<3.0.0" "empy==3.3.4"

# Pre-build so mission runs do not race a first-time compile.
RUN cd /PX4-Autopilot && make px4_sitl_default

WORKDIR /workspace
CMD ["/bin/bash"]
